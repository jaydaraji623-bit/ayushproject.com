# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for Admin Dashboard access.
# If left empty, the first admin user can claim an admin password inline on first launch.
ADMIN_PASSCODE=

# SESSION_SECRET: Optional HMAC secret for signing session tokens (falls back to runtime random secret).
SESSION_SECRET=
